<?xml version="1.0" encoding="utf-8"?>
<!--
  导出文件的共享路径。

  为什么需要它：导出的 PDF/PNG/MD 写在应用私有缓存目录（cacheDir/exports）。
  Android 7.0+ 起不允许用 file:// URI 把私有文件交给别的应用（会抛
  FileUriExposedException），必须通过 FileProvider 生成 content:// URI。
  不配这个，导出的文件就只能自己看、无法分享或发给别人。

  cache-path 而不是 files-path：导出物是**可再生成的中间产物**，
  放缓存目录让系统在空间紧张时自动清理，不占用用户存储配额。
-->
<paths>
    <cache-path name="exports" path="exports/" />
</paths>
