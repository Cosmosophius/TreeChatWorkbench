    /**
     * 解析消息里存的图片 JSON（data URI 数组）。
     *
     * 解析失败一律当作"没有图片"：图片是附加信息，
     * 一段坏 JSON 不该让整轮对话发不出去。
     */
    private fun decodeImages(imagesJson: String?): List<String> {
        if (imagesJson.isNullOrBlank()) return emptyList()
        return runCatching {
            val type = object : com.google.gson.reflect.TypeToken<List<String>>() {}.type
            gson.fromJson<List<String>>(imagesJson, type) ?: emptyList()
        }.getOrDefault(emptyList())
    }

    /** 把图片列表编码成入库用的 JSON。空列表存 null，避免库里出现无意义的 `[]`。 */
    private fun encodeImages(images: List<String>): String? =
        if (images.isEmpty()) null else gson.toJson(images)

    // ========================================================================
