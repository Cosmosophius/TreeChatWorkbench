     * 在保存时写回磁盘（与 `settings` 的持有方式一致，避免两份实例不同步）。
     */
    var savedProviders by mutableStateOf<List<ProviderConfig>>(emptyList())
        private set

    /**
     * 合并一批服务商进来（按 id 覆盖，幂等）。
     *
     * 与 DeepSeek Harness 的 `set(["providers", id])` 语义一致：同名 id 是
     * **更新那一条**，不是追加成两条。列表顺序保持稳定（已存在则原位替换，
     * 新的追加到末尾），这样用户在设置里的排序不会因为一次保存而跳乱。
     */
    fun upsertProviders(incoming: List<ProviderConfig>, makeActive: ProviderConfig?) {
        if (incoming.isNotEmpty()) {
            val merged = savedProviders.toMutableList()
            incoming.forEach { provider ->
                val index = merged.indexOfFirst { it.id == provider.id }
                if (index >= 0) merged[index] = provider else merged.add(provider)
            }
            savedProviders = merged
        }
        if (makeActive != null) activeProvider = makeActive
    }

    /** 删除一条服务商；若删的正是当前选中项，则回落到剩余的第一条。 */
    fun removeProvider(id: String) {
        val remaining = savedProviders.filterNot { it.id == id }
        savedProviders = remaining
        if (activeProvider.id == id) {
            remaining.firstOrNull()?.let { activeProvider = it }
        }
    }

    /**
     * 用给定列表**整体替换**已保存的服务商。
     *
     * 与 upsertProviders 的关键差别：**它会删除**不在列表里的条目。
     * 删除服务商必须走这里 —— upsert 只做合并，被删掉的那条会在下一次
     * 落盘时"复活"（因为落盘读的是 savedProviders 全集）。
     *
     * 若当前选中的服务商已不在新列表里，回落到新列表的第一条；
     * 新列表为空时保留原选中项（界面此时处于"一个都没有"的状态，
     * UI 会引导去添加，而不是静默清空）。
     */
    fun replaceProviders(next: List<ProviderConfig>) {
        savedProviders = next
        if (next.isNotEmpty() && next.none { it.id == activeProvider.id }) {
            activeProvider = next.first()
        }
    }

    /** 切换当前服务商。id 不存在时什么都不做（不静默改成别的）。 */
    fun selectProvider(id: String) {
        savedProviders.firstOrNull { it.id == id }?.let { activeProvider = it }
    }

