    /**
     * 取或建一个**根目录下**、以 [name] 命名的文件夹（同名复用，不重复创建）。
     *
     * 为什么复用而不是每次新建：词典提问都应该收在同一个「词典」文件夹里，
     * 书籍问答都应该收在同一个「《书名》」文件夹里。若每次提问都新建，
     * 用户点开文件视图会看到几十个同名文件夹 —— 那比不归档更糟。
     */
    private suspend fun ensureRootFolderByName(name: String): Folder {
        val trimmed = name.trim().ifBlank { "未命名" }
        val existing = folderDao.getAllFolders()
            .firstOrNull { it.parentFolderId == null && it.name == trimmed }
        if (existing != null) return existing
        val folder = Folder(parentFolderId = null, name = trimmed)
        folderDao.insertFolder(folder)
        return folder
    }

    /**
     * 在名为 [folderName] 的文件夹下新建一个会话（含 root 节点），
     * 可选地把 [question] 作为首条用户消息写入并立即开始生成。
     *
     * 词典的「选词提问」传入 folderName = "词典"；阅读器对书提问传入
     * folderName = 书名。两者都只是调用方给的字符串，这里不写死任何业务名。
     *
     * @param originQuote 选中的原文片段（对话分支的引用来源），可为空。
     * @param onCreated 回调在**主线程**触发，给出可开窗的 root 节点 id 与会话 id。
     */
    fun createQuestionInFolder(
        folderName: String,
        conversationTitle: String,
        question: String,
        originQuote: String? = null,
        onCreated: (nodeId: String, conversationId: String) -> Unit
    ) {
        val trimmedQuestion = question.trim()
        if (trimmedQuestion.isEmpty() && originQuote.isNullOrBlank()) return
        viewModelScope.launch(Dispatchers.IO) {
            val folder = ensureRootFolderByName(folderName)
            val conversation = createConversationInternal(
                folderId = folder.id,
                title = conversationTitle.trim().ifBlank { folder.name },
                sourceOrigin = "来自「${folder.name}」",
                seedWelcome = false
            )
            val root = dao.getRootNodeForConversation(conversation.id) ?: return@launch
            if (!originQuote.isNullOrBlank()) {
                dao.updateNode(root.copy(originQuote = originQuote))
            }
            if (trimmedQuestion.isNotEmpty()) {
                dao.insertMessage(
                    ChatMessage(nodeId = root.id, role = "user", content = trimmedQuestion)
                )
            }
            folderDao.touchConversation(conversation.id, System.currentTimeMillis())

            // 先回调（界面据此开窗/切视图），再起流式补全 ——
            // 反过来的话，用户要等到第一段生成完成才看到窗口出现。
            withContext(Dispatchers.Main) { onCreated(root.id, conversation.id) }
            if (trimmedQuestion.isNotEmpty()) {
                runCompletion(root.id)
            }
        }
    }

