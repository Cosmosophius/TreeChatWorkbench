    /**
     * 生成一条例句。
     *
     * 走与对话完全相同的通路（[aiClient.runChat]），因此当前选中的服务商
     * 是本地 NPU 离线模型时也会自动路由到端侧引擎，不需要另配一套。
     * 联网检索刻意关掉：让模型写一句例句不该先搜一遍网，那是浪费。
     *
     * @return 成功时给出 (例句, 中文翻译)；失败给出可读异常。
     */
    suspend fun generateWordExample(word: String, kind: WordKind): Result<Pair<String, String>> =
        withContext(Dispatchers.IO) {
            val clean = word.trim()
            if (clean.isEmpty()) {
                return@withContext Result.failure(IllegalArgumentException("请先输入要造句的词"))
            }
            val provider = activeProvider
            if (provider.apiKey.isBlank()) {
                return@withContext Result.failure(
                    IllegalStateException("尚未配置 API 密钥，无法生成例句")
                )
            }
            val systemPrompt =
                "你是词典例句编写助手。只输出一行例句与一行中文翻译，两者之间用 ||| 分隔；" +
                    "不要解释、不要编号、不要加引号。"
            val userPrompt = when (kind) {
                WordKind.EN -> "用英语单词「$clean」写一个地道的英语例句，并给出对应的中文翻译。"
                WordKind.RU -> "用俄语单词「$clean」写一个地道的俄语例句，并给出对应的中文翻译。"
                WordKind.HANZI -> "用汉字「$clean」写一个简洁的现代汉语例句，并给出对应的英文翻译。"
            }

            val builder = StringBuilder()
            try {
                aiClient.runChat(
                    provider = provider,
                    messages = listOf(PromptMessage(role = "user", content = userPrompt)),
                    systemPrompt = systemPrompt,
                    searchConfig = settings.searchConfig().copy(enabled = false)
                ).collect { event ->
                    when (event) {
                        is ChatEvent.Text -> builder.append(event.delta)
                        is ChatEvent.Failed -> throw IllegalStateException(event.message)
                        else -> Unit
                    }
                }
            } catch (e: kotlinx.coroutines.CancellationException) {
                throw e
            } catch (e: Exception) {
                return@withContext Result.failure(
                    IllegalStateException(e.localizedMessage ?: "生成失败")
                )
            }

            val raw = builder.toString().trim()
            if (raw.isEmpty()) {
                return@withContext Result.failure(IllegalStateException("模型没有返回内容"))
            }
            val pair = splitExample(raw)
            Result.success(pair)
        }

    /** 把模型输出拆成 (例句, 翻译)：优先按 `|||` 分隔，否则按首行/其余行。 */
    private fun splitExample(raw: String): Pair<String, String> {
        fun tidy(s: String): String = s.trim().trim('"', '「', '」', '\'', '“', '”')
        val sep = raw.indexOf("|||")
        if (sep >= 0) {
            return tidy(raw.substring(0, sep)) to tidy(raw.substring(sep + 3))
        }
        val lines = raw.lines().map { it.trim() }.filter { it.isNotEmpty() }
        val sentence = tidy(lines.firstOrNull().orEmpty())
        val translation = tidy(lines.drop(1).joinToString(" "))
        return sentence to translation
    }

    // ========================================================================
    // 阅读器：选句翻译 / 句法切分（一次性文本推理）
    // ========================================================================
    //
    // 这两件事都只需要"把一段文字交给当前模型、拿回一段文本"，既不落库、也
    // 不进对话树、更不该顺带搜一遍网。所以它们复用 [AiStreamClient.runChat] 这
    // 条与对话**完全相同**的通路（本地 NPU 离线模型会自动路由到端侧引擎），
    // 而不另起一套 HTTP 客户端 —— 另起一套必然出现"对话能用、翻译不能用"。
    //
    // 之所以把提示词放在 ViewModel 里而不是 UI 里：与 [generateWordExample] 一致，
    // 提示词的措辞与输出约定是"模型契约"，不该散落在界面代码里。

    /**
     * 当前服务商能否做一次性文本推理；不能时给出**人类可读的原因**（null = 看起来可用）。
     *
     * 判据只有一条，与 [runCompletion] 的入口检查一致：云端服务商没填 API 密钥。
     *
     * 注：本地大模型（NPU / llama.cpp）方案已按用户要求整体移除，因此不再有
     * "本地模型未挂载"这一条判据。
     *
     * 这里只做"提前拦一刀"，让界面能明确说出原因；真正的可用性仍以推理时的
     * 错误为准，那时把原始错误照实抛出，不在这里假装成功。
     */
    fun oneShotUnavailableReason(): String? {
        val provider = activeProvider
        return when {
            provider.apiKey.isBlank() ->
                "当前服务商「${provider.name}」未配置 API 密钥，无法推理。" +
                    "请在「设置」中填写密钥。"
            else -> null
        }
    }

