    /**
     * 从 content:// URI 取用户可见的文件名。
     *
     * 为什么需要它：`ActivityResultContracts` 回传的 URI 路径形如
     * `content://com.android.providers.downloads.documents/document/1234`，
     * 末段是内部 ID，**不能当文件名用**（否则用户会看到"已导入 1234"）。
     * 必须查 ContentResolver 的 `OpenableColumns.DISPLAY_NAME`。
     *
     * 查不到时回退到 URI 末段，至少还能显示出一点线索。
     */
    fun resolveDisplayName(uri: android.net.Uri): String {
        val fromResolver = runCatching {
            getApplication<android.app.Application>().contentResolver
                .query(uri, null, null, null, null)?.use { cursor ->
                    val index = cursor.getColumnIndex(android.provider.OpenableColumns.DISPLAY_NAME)
                    if (index >= 0 && cursor.moveToFirst()) cursor.getString(index) else null
                }
        }.getOrNull()
        if (!fromResolver.isNullOrBlank()) return fromResolver
        return uri.lastPathSegment?.substringAfterLast('/')?.takeIf { it.isNotBlank() } ?: "未命名文档"
    }

