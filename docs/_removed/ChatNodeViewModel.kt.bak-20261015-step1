    /** targetId 是否位于 ancestorId 的子树中。 */
    private suspend fun isDescendant(targetId: String, ancestorId: String): Boolean {
        val all = folderDao.getAllFolders().associateBy { it.id }
        var cursor = all[targetId]
        var guard = 0
        while (cursor != null && guard++ < 512) {
            if (cursor.parentFolderId == ancestorId) return true
            cursor = cursor.parentFolderId?.let { all[it] }
        }
        return false
    }

