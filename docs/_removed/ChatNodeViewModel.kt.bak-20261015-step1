    /**
     * 复制对话副本（任务 B8：支持整棵对话树与全部节点/消息的深拷贝）
     */
    fun duplicateConversation(conversationId: String) {
        viewModelScope.launch(Dispatchers.IO) {
            val origin = folderDao.getConversationById(conversationId) ?: return@launch
            val newId = java.util.UUID.randomUUID().toString()
            val now = System.currentTimeMillis()
            val newConv = origin.copy(
                id = newId,
                title = "${origin.title} (副本)",
                createdAt = now,
                updatedAt = now
            )
            folderDao.insertConversation(newConv)

            val originNodes = dao.getNodesForConversation(conversationId)
            val idMap = mutableMapOf<String, String>()
            originNodes.forEach { oldNode ->
                idMap[oldNode.id] = java.util.UUID.randomUUID().toString()
            }
            originNodes.forEach { oldNode ->
                val newNodeId = idMap[oldNode.id] ?: return@forEach
                val newParentId = oldNode.parentId?.let { idMap[it] }
                val clonedNode = oldNode.copy(
                    id = newNodeId,
                    conversationId = newId,
                    parentId = newParentId,
                    createdAt = now
                )
                dao.insertNode(clonedNode)

                val msgs = dao.getMessagesForNode(oldNode.id)
                msgs.forEach { m ->
                    val clonedMsg = m.copy(
                        id = java.util.UUID.randomUUID().toString(),
                        nodeId = newNodeId,
                        createdAt = now
                    )
                    dao.insertMessage(clonedMsg)
                }
            }
        }
    }

    /**
     * 导入 .talktree 跨平台对话档案。
     * 重新分配 UUID 并保留完整的父子拓扑树关系与各节点消息记录。
     */
    fun importTalkTreeBundle(
        bundle: com.treechat.workbench.export.TalkTreeBundle,
        targetFolderId: String?,
        onComplete: (newConvId: String) -> Unit = {}
    ) {
        viewModelScope.launch(Dispatchers.IO) {
            val newConvId = java.util.UUID.randomUUID().toString()
            val now = System.currentTimeMillis()
            val importedConv = bundle.conversation.copy(
                id = newConvId,
                folderId = targetFolderId,
                title = bundle.conversation.title.ifBlank { "已导入对话" },
                sourceOrigin = "来自 .talktree 档案导入",
                createdAt = now,
                updatedAt = now
            )
            folderDao.insertConversation(importedConv)

            val idMap = mutableMapOf<String, String>()
            bundle.nodes.forEach { oldNode ->
                idMap[oldNode.id] = java.util.UUID.randomUUID().toString()
            }

            bundle.nodes.forEach { oldNode ->
                val newNodeId = idMap[oldNode.id] ?: java.util.UUID.randomUUID().toString()
                val newParentId = oldNode.parentId?.let { idMap[it] }
                val newNode = oldNode.copy(
                    id = newNodeId,
                    conversationId = newConvId,
                    parentId = newParentId,
                    createdAt = oldNode.createdAt
                )
                dao.insertNode(newNode)
            }

            bundle.messages.forEach { oldMsg ->
                val targetNodeId = idMap[oldMsg.nodeId] ?: return@forEach
                val newMsg = oldMsg.copy(
                    id = java.util.UUID.randomUUID().toString(),
                    nodeId = targetNodeId
                )
                dao.insertMessage(newMsg)
            }

            withContext(Dispatchers.Main) {
                onComplete(newConvId)
            }
        }
    }

