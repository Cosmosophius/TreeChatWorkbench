    fun openConversation(conversationId: String) {
        viewModelScope.launch(Dispatchers.IO) {
            openConversationInternal(conversationId)
        }
    }

    private suspend fun openConversationInternal(conversationId: String) {
        _activeConversationId.value = conversationId
        // 先清空根节点，再异步加载新的。
        // 否则切换会话的瞬间，聊天视图会先用旧会话的 rootNodeId 渲染一帧 ——
        // 表现为"点进新对话，闪了一下上一个对话的内容"。
        _rootNodeId.value = null

        var root = dao.getRootNodeForConversation(conversationId)
        if (root == null) {
            // 容错：会话存在但根节点缺失（例如被误删）时补一个，避免聊天页空白
            val conv = folderDao.getConversationById(conversationId)
            root = ConversationNode(
                conversationId = conversationId,
                parentId = null,
                title = conv?.title ?: "主对话"
            )
            dao.insertNode(root)
        }
        _rootNodeId.value = root.id

        // 兜底复位：如果上一次运行是"正在生成时被系统杀掉/强退"，
        // 库里那条 assistant 消息的 is_streaming 会永久留在 1，
        // 于是重新打开这个会话时它一直显示"生成中"，且没有任何协程会去清它。
        // 这里在打开会话时把这些残留标记清掉。
        resetStaleStreamingFlags(conversationId)
    }

    /** 清掉会话内遗留的"生成中"标记（进程被杀留下的僵尸状态）。 */
    private suspend fun resetStaleStreamingFlags(conversationId: String) {
        runCatching {
            val conversationNodes = dao.getNodesForConversation(conversationId)
            conversationNodes.forEach { node ->
                val messages = dao.getMessagesForNode(node.id)
                messages.filter { it.isStreaming }.forEach { stale ->
                    dao.updateMessage(stale.copy(isStreaming = false))
                }
            }
        }
    }

    fun createConversation(folderId: String?, title: String) {
        viewModelScope.launch(Dispatchers.IO) {
            val conv = createConversationInternal(
                folderId = folderId,
                title = title.ifBlank { "新对话" },
                sourceOrigin = "手动创建",
                seedWelcome = false
            )
            openConversationInternal(conv.id)
        }
    }

    private suspend fun createConversationInternal(
        folderId: String?,
        title: String,
        sourceOrigin: String?,
        seedWelcome: Boolean
    ): Conversation {
        val conversation = Conversation(
            folderId = folderId,
            title = title,
            sourceOrigin = sourceOrigin
        )
        folderDao.insertConversation(conversation)
        val root = ConversationNode(
            conversationId = conversation.id,
            parentId = null,
            title = title
        )
        dao.insertNode(root)

        if (seedWelcome) {
            dao.insertMessage(
                ChatMessage(
                    nodeId = root.id,
                    role = "assistant",
                    content = WELCOME_MARKDOWN
                )
            )
        }
        return conversation
    }

    fun renameConversation(conversationId: String, newTitle: String) {
        if (newTitle.isBlank()) return
        viewModelScope.launch(Dispatchers.IO) {
            val conv = folderDao.getConversationById(conversationId) ?: return@launch
            folderDao.updateConversation(conv.copy(title = newTitle.trim()))
        }
    }

    fun deleteConversation(conversationId: String) {
        viewModelScope.launch(Dispatchers.IO) {
            // 会话与节点之间没有外键，级联要显式做：
            // 先删节点（消息随节点外键级联），再删会话本身
            dao.deleteNodesByConversation(conversationId)
            folderDao.deleteConversationById(conversationId)

            // 删掉的正好是当前会话时，切到列表里的下一个
            if (_activeConversationId.value == conversationId) {
                val remaining = folderDao.observeAllConversations().first()
                val next = remaining.firstOrNull()
                    ?: createConversationInternal(
                        folderId = null,
                        title = "主干对话",
                        sourceOrigin = "自动重建",
                        seedWelcome = false
                    )
                openConversationInternal(next.id)
            }
        }
    }

