    private val _knowledgeBusy = MutableStateFlow(false)

    /** 是否正在导入（解析 + 建索引可能耗时数十秒，界面需要转圈并禁用按钮）。 */
    val knowledgeBusy: StateFlow<Boolean> = _knowledgeBusy.asStateFlow()

    private val _knowledgeMessage = MutableStateFlow<String?>(null)

    /** 最近一次导入/删除的结果提示，供界面用 Snackbar 或文字展示。 */
    val knowledgeMessage: StateFlow<String?> = _knowledgeMessage.asStateFlow()

    fun clearKnowledgeMessage() {
        _knowledgeMessage.value = null
    }

    /**
     * 导入一份文档：解析 → 切块 → 建 2 字组索引 → 整份入库。
     *
     * ## 为什么整条流水线必须在 Dispatchers.IO
     * 解析要读整个文件（教材可达数 MB），切块与建索引是**纯 CPU 计算**
     * （几 MB 文本会产生数十万个 2 字组）。放在主线程会直接 ANR ——
     * 这是交接文档里明确标注过的风险点。
     *
     * ## 为什么失败不抛异常而是给提示
     * 用户会导入各种格式（旧 .doc、扫描版 PDF、加密 docx），
     * 这些失败是可预期的。直接把异常抛到界面上只会显示一串看不懂的堆栈，
     * 所以这里转成可读文案。
     */
    fun importKnowledgeDocument(
        uri: android.net.Uri,
        displayName: String,
        folderPath: String = ""
    ) {
        viewModelScope.launch(Dispatchers.IO) {
            _knowledgeBusy.value = true
            _knowledgeMessage.value = null
            try {
                val parsed = DocumentParser.parse(getApplication(), uri, displayName)

                if (parsed.text.isBlank()) {
                    _knowledgeMessage.value = "「$displayName」解析后没有文字内容（可能是扫描版或空文档）"
                    return@launch
                }

                val title = displayName.substringBeforeLast('.').ifBlank { displayName }
                val docId = java.util.UUID.randomUUID().toString()
                // 默认导入不切片建立索引（任务 B3），实现毫秒级快速导入
                val doc = KnowledgeDocument(
                    id = docId,
                    title = title,
                    fileName = displayName,
                    sourceType = parsed.sourceType,
                    charCount = parsed.text.length,
                    chunkCount = 0,
                    folderPath = folderPath.trim('/')
                )
                knowledgeDao.insertDocument(doc)
                _knowledgeMessage.value = "已导入「$title」（未索引，可按需手动构建切片）"
            } catch (e: DocumentParser.UnsupportedFormatException) {
                _knowledgeMessage.value = e.message ?: "不支持的文件格式"
            } catch (e: kotlinx.coroutines.CancellationException) {
                throw e
            } catch (e: Exception) {
                // 兜底：不让任何解析/入库异常把应用带崩
                _knowledgeMessage.value =
                    "导入失败：${e.javaClass.simpleName} ${e.localizedMessage.orEmpty()}".trim()
            } finally {
                _knowledgeBusy.value = false
            }
        }
    }

    /**
     * 把一段**已经解析好的正文**直接入库并建立索引。
     *
     * 为什么需要它：阅读器在导入时已经把文件解析过一遍（扫描件还做过整本离线 OCR），
     * 再按 URI 让知识库重解析一次等于白跑第二遍 OCR。这里直接收正文，
     * 解析与索引两步分开，各自只做一次。
     */
    fun importKnowledgeText(
        title: String,
        fileName: String,
        text: String,
        sourceType: String,
        folderPath: String = ""
    ) {
        if (text.isBlank()) {
            _knowledgeMessage.value = "「$title」没有可入库的正文"
            return
        }
        viewModelScope.launch(Dispatchers.IO) {
            val docId = java.util.UUID.randomUUID().toString()
            try {
                knowledgeDao.insertDocument(
                    KnowledgeDocument(
                        id = docId,
                        title = title,
                        fileName = fileName,
                        sourceType = sourceType,
                        charCount = text.length,
                        chunkCount = 0,
                        folderPath = folderPath.trim('/')
                    )
                )
            } catch (e: Exception) {
                _knowledgeMessage.value =
                    "入库失败：${e.javaClass.simpleName} ${e.localizedMessage.orEmpty()}".trim()
                return@launch
            }
            // 复用与「手动构建索引」完全相同的那条流水线（本地 2-gram 倒排 / 云端向量）。
            buildDocumentIndex(docId, text, title)
        }
    }

    /**
     * 「书架」统一导入：把一份已经解析好的文档**同时**写进两处，两者共用同一个 id。
     *
     * - Room 的 `knowledge_documents`（RAG 检索的唯一真相）：检索只认它；
     * - 阅读状态由调用方（书架界面）用同一个 id 写进 ReaderDocumentPool（正文/页码/OCR 状态）。
     *
     * 为什么不让内部自己生成 id：阅读侧与检索侧必须对齐同一个 id 才可能"一处导入、两处可见"。
     * 旧实现里阅读器卡片走 [importKnowledgeText] 会另起一个随机 UUID，于是同一本书在
     * Room 与阅读池里是两个 id，互相看不见 —— 这正是"两个池子不互通"的根因。
     *
     * 导入即建索引（[buildDocumentIndex]），因此导入后立即可被检索命中；若只想登记不建索引，
     * 传 `indexNow = false`。
     */
    fun importShelfDocument(
        documentId: String,
        title: String,
        fileName: String,
        sourceType: String,
        text: String,
        folderPath: String = "",
        indexNow: Boolean = true,
        scheme: RagIndexingScheme? = null
    ) {
        if (text.isBlank()) {
            _knowledgeMessage.value = "「$title」没有可入库的正文"
            return
        }
        viewModelScope.launch(Dispatchers.IO) {
            try {
                knowledgeDao.insertDocument(
                    KnowledgeDocument(
                        id = documentId,
                        title = title,
                        fileName = fileName,
                        sourceType = sourceType,
                        charCount = text.length,
                        chunkCount = 0,
                        folderPath = folderPath.trim('/')
                    )
                )
            } catch (e: Exception) {
                _knowledgeMessage.value =
                    "入库失败：${e.javaClass.simpleName} ${e.localizedMessage.orEmpty()}".trim()
                return@launch
            }
            if (indexNow) buildDocumentIndex(documentId, text, title, scheme)
        }
    }

    /**
     * 为一份「只有阅读状态、Room 里还没有对应行」的旧书记录补建 Room 文档行（id 相同）。
     *
     * 数据安全：这是老版本 `reader_document_pool` 里遗留的书能被"书架"看见且不丢失的关键。
     * **先查后插**，绝不 REPLACE 覆盖已有行 —— `insertDocument` 是 `INSERT OR REPLACE`，
     * 覆盖已有行会触发 SQLite 先删旧行，进而级联删掉该书的 chunks / grams（索引全丢）。
     *
     * 只补建元信息（chunkCount = 0，未建索引），不自动切块：旧书的正文可能非常大，
     * 静默建索引会让切页/重启卡住；用户需要时在书架卡片菜单里手动「接入知识库」即可。
     */
    suspend fun ensureShelfRoomDocument(
        documentId: String,
        title: String,
        fileName: String,
        sourceType: String,
        charCount: Int
    ) = withContext(Dispatchers.IO) {
        runCatching {
            if (knowledgeDao.getDocument(documentId) == null) {
                knowledgeDao.insertDocument(
                    KnowledgeDocument(
                        id = documentId,
                        title = title,
                        fileName = fileName,
                        sourceType = sourceType,
                        charCount = charCount,
                        chunkCount = 0
                    )
                )
            }
        }
    }

    /**
     * 书架卡片「接入 / 重建知识库索引（选方案）」的落地入口。
     *
     * 与 [rebuildDocumentIndex] 的差别：书架**手上就有阅读正文**（ReaderDocument.sampleText），
     * 没有切片也能建索引。因此：
     *  - 有正文：先清旧索引（保留文档本身），再按所选方案重建；
     *  - 没正文（例如从旧知识库设置页导入、已无本地文件的书）：退回用库里已有切片拼回正文重建。
     */
    fun indexShelfDocument(
        documentId: String,
        text: String?,
        title: String? = null,
        scheme: RagIndexingScheme? = null
    ) {
        viewModelScope.launch(Dispatchers.IO) {
            if (text.isNullOrBlank()) {
                rebuildDocumentIndex(documentId, scheme ?: RagIndexingScheme.LOCAL_OFFLINE, title)
                return@launch
            }
            _knowledgeBusy.value = true
            _knowledgeMessage.value = "正在清除该文档的旧索引..."
            val cleared = runCatching { knowledgeDao.safeClearDocumentIndex(documentId) }
            _knowledgeBusy.value = false
            if (cleared.isFailure) {
                _knowledgeMessage.value =
                    "清除旧索引失败：${cleared.exceptionOrNull()?.localizedMessage.orEmpty()}".trim()
                return@launch
            }
            buildDocumentIndex(documentId, text, title, scheme)
        }
    }

    /**
     * 手动触发文档切片索引构建（双方案支持：本地 2-gram 倒排 或 云端 Embedding 向量）。
     *
     * [scheme] 是**这一份文档**显式指定的索引方案：
     *  - 传 `null`（默认）时完全沿用全局设置（含全局“云端 RAG 开关”），既有调用点行为不变；
     *  - 传非 null 时以用户为该文档的选择为准；若选的是云端方案而云端配置不合法，
     *    会如实报错并终止，**绝不静默退回本地**。
     */
    fun buildDocumentIndex(
        documentId: String,
        text: String,
        title: String? = null,
        scheme: RagIndexingScheme? = null
    ) {
        viewModelScope.launch(Dispatchers.IO) {
            _knowledgeBusy.value = true
            _knowledgeMessage.value = "正在切片..."
            // 登记为后台任务：切片/向量/倒排都可能跑几十秒，用户切走后还能调出面板看进度
            val taskId = BackgroundTaskRegistry.start(
                title = "切片建索引${if (title.isNullOrBlank()) "" else "：《$title》"}",
                detail = "正在切片…"
            )
            try {
                val cloudConfig = settings.cloudRagConfig()
                val effectiveScheme = scheme ?: cloudConfig.scheme
                val wantsCloudVectors =
                    effectiveScheme == RagIndexingScheme.CLOUD_EMBEDDING ||
                        effectiveScheme == RagIndexingScheme.HYBRID

                // 显式选择云端方案但云端配置不合法：如实报错并终止，不放行也不退回本地
                val explicitCloudIssue =
                    if (scheme != null) cloudSchemeIssue(effectiveScheme, cloudConfig) else null
                if (explicitCloudIssue != null) {
                    _knowledgeMessage.value = explicitCloudIssue
                    BackgroundTaskRegistry.fail(taskId, explicitCloudIssue)
                    return@launch
                }

                // 显式指定方案时以用户选择为准（不再受全局云端开关影响）；
                // 未指定时沿用既有全局判定：全局开关 + 云端方案 + 配置合法。
                val isCloudMode =
                    if (scheme != null) wantsCloudVectors
                    else cloudConfig.enabled && wantsCloudVectors && cloudConfig.isValidForApi()

                val chunks = Chunker.chunk(documentId, text)
                if (chunks.isEmpty()) {
                    _knowledgeMessage.value = "文档切块结果为空"
                    BackgroundTaskRegistry.finish(taskId, BackgroundTaskRegistry.State.FAILED, "切块结果为空")
                    return@launch
                }
                BackgroundTaskRegistry.update(
                    taskId,
                    detail = "已切成 ${chunks.size} 段，准备建索引…",
                    progress = 0.3f
                )

                val finalChunks = if (isCloudMode) {
                    _knowledgeMessage.value = "正在请求云端 API 厂商批量生成向量 Embedding (${chunks.size} 块)..."
                    BackgroundTaskRegistry.update(taskId, "正在向云端请求向量 Embedding（${chunks.size} 块）…", 0.5f)
                    val textsToEmbed = chunks.map { it.text }
                    val vectors = cloudEmbeddingClient.getEmbeddings(textsToEmbed, cloudConfig)
                    chunks.mapIndexed { index, chunk ->
                        val vec = vectors.getOrNull(index)
                        if (vec != null && vec.isNotEmpty()) {
                            chunk.copy(embedding = com.treechat.workbench.rag.CloudEmbeddingClient.encodeVector(vec))
                        } else {
                            chunk
                        }
                    }
                } else {
                    chunks
                }

                _knowledgeMessage.value = "正在构建本地 2-gram 倒排索引并落库..."
                BackgroundTaskRegistry.update(taskId, "正在建 2-gram 倒排索引并落库…", 0.75f)
                // 先落方案标识再写切片：紧随其后的 DAO 写库会触发 Room 失效通知，
                // 界面重查文档列表时就带上新方案，卡片徽标不会停留在旧值。
                // 记录"实际用到的方案"：没走云端向量时就如实记本地，不冒充云端。
                val recordedScheme =
                    if (isCloudMode) effectiveScheme else RagIndexingScheme.LOCAL_OFFLINE
                updateDocumentIndexingScheme(documentId, recordedScheme)
                val grams = Chunker.buildIndex(documentId, finalChunks)
                knowledgeDao.insertChunks(finalChunks)
                knowledgeDao.insertGrams(grams)
                knowledgeDao.updateDocumentChunkCount(documentId, finalChunks.size)

                val schemeName = when {
                    isCloudMode && effectiveScheme == RagIndexingScheme.HYBRID ->
                        "云端向量 + 本地 2-gram 双路混合"
                    isCloudMode -> "云端向量 + 本地双索引"
                    else -> "纯本地 2-gram 倒排索引"
                }
                _knowledgeMessage.value = "索引构建完成 ($schemeName)：生成 ${finalChunks.size} 个切片段落"
                BackgroundTaskRegistry.finish(
                    taskId,
                    BackgroundTaskRegistry.State.DONE,
                    "$schemeName · ${finalChunks.size} 段切片"
                )
            } catch (e: Exception) {
                _knowledgeMessage.value = "构建索引失败: ${e.message}"
                BackgroundTaskRegistry.fail(taskId, e.localizedMessage ?: e.javaClass.simpleName)
            } finally {
                _knowledgeBusy.value = false
            }
        }
    }

    /**
     * 按指定方案**重建**某份文档的切片索引（逐份文档选择方案的落地入口）。
     *
     * 顺序：先校验方案（云端配置不合法则如实报错、**不动**旧数据）→ 取库里已有切片文本拼回正文
     * → 清旧索引（复用 [com.treechat.workbench.data.db.KnowledgeDao.safeClearDocumentIndex]，
     * 只清切片与倒排，保留文档记录本身）→ 复用 [buildDocumentIndex] 按所选方案重建。
     *
     * 为什么文本要用已有切片拼回：入口在管理界面，此处并不持有原文；切片里存的就是当初入库的
     * 正文，拼回即可近似还原。若库里没有任何切片，则如实提示，绝不拿空串去建索引。
     */
    fun rebuildDocumentIndex(
        documentId: String,
        scheme: RagIndexingScheme,
        title: String? = null
    ) {
        viewModelScope.launch(Dispatchers.IO) {
            // 1. 前置校验：配置不合法时不清理旧索引，直接如实报错（保护已有数据）
            val cloudIssue = cloudSchemeIssue(scheme, settings.cloudRagConfig())
            if (cloudIssue != null) {
                _knowledgeMessage.value = cloudIssue
                return@launch
            }

            // 2. 取重建正文：优先用库里已有切片文本拼回
            val existingChunks = runCatching { knowledgeDao.getChunksForDocument(documentId) }
                .getOrDefault(emptyList())
            val rebuiltText = existingChunks.joinToString("\n\n") { it.text }
            if (rebuiltText.isBlank()) {
                _knowledgeMessage.value =
                    "该文档还没有正文可重建索引（库里没有切片，原文不单独留存）；请重新导入该文档后再建索引"
                return@launch
            }

            // 3. 先清旧索引（保留文档本身，不删书）
            _knowledgeBusy.value = true
            _knowledgeMessage.value = "正在清除该文档的旧索引..."
            try {
                knowledgeDao.safeClearDocumentIndex(documentId)
            } catch (e: Exception) {
                _knowledgeMessage.value = "清除旧索引失败：${e.localizedMessage.orEmpty()}".trim()
                _knowledgeBusy.value = false
                return@launch
            }

            // 4. 按所选方案重建（busy 的收尾交给 buildDocumentIndex 的 finally）
            buildDocumentIndex(documentId, rebuiltText, title, scheme)
        }
    }

    /**
     * 云端方案配置校验：返回 null 表示可用；否则返回面向用户的不可用原因。
     * 纯本地方案不依赖云端配置，恒返回 null。
     */
    private fun cloudSchemeIssue(
        scheme: RagIndexingScheme,
        config: com.treechat.workbench.rag.CloudRagConfig
    ): String? {
        val wantsCloudVectors =
            scheme == RagIndexingScheme.CLOUD_EMBEDDING || scheme == RagIndexingScheme.HYBRID
        if (!wantsCloudVectors) return null
        if (!config.isValidForApi()) {
            return "云端方案需要先填写 API 地址与密钥（缺少 Base URL / API Key / Embedding 模型）"
        }
        return null
    }

    /**
     * 原地写入某份文档的索引方案标识（对应实体已有的 [KnowledgeDocument.indexingScheme] 列）。
     *
     * 为什么不走 DAO：知识库 DAO 没有“只更这一列”的方法，而 `insertDocument` 是
     * `INSERT OR REPLACE` —— 用它重插 documents 行会让 SQLite 先删旧行，进而触发
     * chunks / grams 的 `ON DELETE CASCADE`，把刚建好的索引连带删掉。
     * 这里用最窄的一条 UPDATE 只改这一列，不新建列、不改 Room 实体、不加迁移。
     */
    private suspend fun updateDocumentIndexingScheme(documentId: String, scheme: RagIndexingScheme) {
        runCatching {
            db.openHelper.writableDatabase.execSQL(
                "UPDATE knowledge_documents SET indexingScheme = ? WHERE id = ?",
                arrayOf<Any?>(scheme.name, documentId)
            )
        }
    }

