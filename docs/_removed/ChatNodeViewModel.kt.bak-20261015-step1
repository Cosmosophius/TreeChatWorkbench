    /**
     * 针对敏感枝条的「脱敏解耦分叉」复合功能：
     *
     * 1. 解耦祖先链（Decoupled Ancestry）：
     *    将新节点的 parentId 设为 null，成为一棵独立生长的安全干净根枝条；
     *    同时记录 sourceMessageId = parentNodeId，保留跨视图面包屑与双向视觉连线。
     * 2. 上下文脱敏与技术摘要擦除（Sanitized Context Extract）：
     *    从原敏感枝条的消息中提取纯技术/学术讨论内容，将可能触发风控的词汇和敏感实体剥离脱敏，
     *    填入新节点的 originQuote，既不丢失前序技术背景，又彻底切断上游违规长上下文。
     * 3. 自动解除敏感标记（Auto-Clear Sensitivity）：
     *    新分支由系统认证为纯净脱敏分支（sensitive = false）。
     */
    suspend fun forkSanitizedBranch(
        sourceNodeId: String,
        sanitizedSummary: String? = null
    ): ConversationNode = withContext(Dispatchers.IO) {
        val sourceNode = dao.getNodeById(sourceNodeId)
        val sourceMessages = dao.getMessagesForNode(sourceNodeId)

        val cleanSummary = sanitizedSummary?.trim().takeIf { !it.isNullOrBlank() }
            ?: run {
                val lastAssistant = sourceMessages.lastOrNull { it.role == "assistant" && it.content.isNotBlank() }
                val lastUser = sourceMessages.lastOrNull { it.role == "user" && it.content.isNotBlank() }
                val combined = "${lastUser?.content.orEmpty()}\n${lastAssistant?.content.orEmpty()}"
                com.treechat.workbench.safety.BranchSafetyAuditor.generateSanitizedText(combined)
            }

        val childTitle = "脱敏接力：" + (sourceNode?.title?.take(10) ?: "独立分支")
        val cleanNode = ConversationNode(
            parentId = null,
            conversationId = sourceNode?.conversationId,
            title = childTitle,
            originQuote = "【已合规脱敏上下文】\n$cleanSummary",
            sourceMessageId = sourceNodeId
        )
        dao.insertNode(cleanNode)

        sensitiveBranchStore.setNodeSensitive(cleanNode.id, false)
        cleanNode
    }

    val conversationDao: com.treechat.workbench.data.db.ConversationDao get() = dao

    /**
     * 可被"关联/挂载"到 [targetNodeId] 之下的候选卡片。
     *
     * 过滤规则（同一会话内）：
     *  1. 排除目标自身；
     *  2. 排除目标的**后代**（它们本就在这棵子树里，挂上去没有意义）；
     *  3. 排除目标的**祖先**（把祖先挂到它自己的后代下面会形成环）。
     *
     * 旧实现只做了 `id != target` 一条（甚至还带 `LIMIT 25` 且不区分会话），
     * 那是会成环的；这里按工程要求补齐了防环过滤。
     */
    suspend fun attachableCandidates(targetNodeId: String): List<ConversationNode> =
        withContext(Dispatchers.IO) {
            val target = dao.getNodeById(targetNodeId) ?: return@withContext emptyList()
            val convId = target.conversationId ?: return@withContext emptyList()
            val all = dao.getNodesForConversation(convId)
            val byParent = all.groupBy { it.parentId }

            // 后代集合（BFS；visited 兼作防环，避免历史脏数据成环时死循环）
            val descendants = mutableSetOf<String>()
            val stack = ArrayDeque(byParent[targetNodeId].orEmpty())
            while (stack.isNotEmpty()) {
                val n = stack.removeFirst()
                if (descendants.add(n.id)) stack.addAll(byParent[n.id].orEmpty())
            }

            // 祖先集合（含自身；guard 防环）
            val ancestors = mutableSetOf<String>()
            val byId = all.associateBy { it.id }
            var cursor: ConversationNode? = target
            var guard = 0
            while (cursor != null && guard++ < 1024) {
                ancestors.add(cursor.id)
                cursor = cursor.parentId?.let { byId[it] }
            }

            all.filter {
                it.id != targetNodeId && it.id !in descendants && it.id !in ancestors
            }
        }

    /**
     * 把 [nodeId] 挂载为 [newParentId] 的下级分支（改 `parentId` 与 `conversationId`）。
     *
     * 对齐旧实现 `showAttachCardsDialog` 里那条
     * `UPDATE conversation_nodes SET parent_id=?, conversation_id=? WHERE id=?`，
     * 但**在提交前重新做一次防环校验**（列表可能已经过期）：若被挂载节点是目标的
     * 祖先（或自身），直接如实返回失败原因，绝不静默改库。
     */
    suspend fun attachNodeToParent(nodeId: String, newParentId: String): Result<Unit> =
        withContext(Dispatchers.IO) {
            if (nodeId == newParentId) {
                return@withContext Result.failure(IllegalStateException("不能把卡片挂到它自己下面"))
            }
            val node = dao.getNodeById(nodeId)
                ?: return@withContext Result.failure(IllegalStateException("找不到要挂载的卡片"))
            val target = dao.getNodeById(newParentId)
                ?: return@withContext Result.failure(IllegalStateException("找不到目标卡片"))

            val convId = target.conversationId
            val all = if (convId == null) emptyList() else dao.getNodesForConversation(convId)
            val byId = all.associateBy { it.id }

            // 从目标沿 parent 上溯：若途中出现被挂载节点，则被挂载节点是目标的祖先 → 成环
            var cursor: ConversationNode? = byId[newParentId]
            var guard = 0
            while (cursor != null && guard++ < 1024) {
                if (cursor.id == nodeId) {
                    return@withContext Result.failure(
                        IllegalStateException("无法关联：该卡片是当前节点的上级分支，挂载后会形成环")
                    )
                }
                cursor = cursor.parentId?.let { byId[it] }
            }

            dao.updateNode(node.copy(parentId = newParentId, conversationId = convId))
            Result.success(Unit)
        }

    /**
     * 为"分支结论提炼与合并 (Branch Merge)"准备草稿。
     *
     * 对齐旧实现 `mergeBranchInsightToParent` 的取数逻辑：
     *  - 先取该分支自己的 `summary`；
     *  - 为空则退化为该分支**最后一条助手消息**的正文；
     *  - 若该节点没有母节点（主干根节点），返回失败并带上旧实现的原话文案。
     *
     * 注意：旧实现**没有调用任何模型**，只是把草稿预填进输入框让用户编辑，
     * 因此这里同样不调用 LLM —— 不会凭空"提炼"出用户没写过的结论。
     */
    suspend fun prepareBranchMerge(nodeId: String): Result<BranchMergeJob> =
        withContext(Dispatchers.IO) {
            val node = dao.getNodeById(nodeId)
                ?: return@withContext Result.failure(IllegalStateException("找不到该分支卡片"))
            val parentId = node.parentId
            if (parentId.isNullOrBlank()) {
                return@withContext Result.failure(
                    IllegalStateException("当前节点为主干根节点，无母节点可反哺")
                )
            }
            val parent = dao.getNodeById(parentId)
            var draft = node.summary.orEmpty()
            if (draft.isBlank()) {
                draft = dao.getMessagesForNode(nodeId)
                    .lastOrNull { it.role == "assistant" && it.content.isNotBlank() }
                    ?.content
                    .orEmpty()
            }
            Result.success(
                BranchMergeJob(
                    branchNodeId = nodeId,
                    parentNodeId = parentId,
                    parentTitle = parent?.title,
                    branchTitle = node.title.ifBlank { "支线思考" },
                    draft = draft
                )
            )
        }

    /**
     * 执行"分支结论提炼与合并"：把结论反哺到母节点上下文。
     *
     * 落库方式**严格对齐旧实现**：
     *  1. 在**母节点**下插入一条 `role='assistant'` 的消息，内容为
     *     `【支线洞察卡片】\n来自探索分支：「分支标题」\n核心结论：\n<结论>`；
     *  2. 把**分支节点**自己的 `summary` 更新为这条结论。
     *
     * 换来的效果：母节点下一轮对话时，`getAncestorChain` 会把这批消息当作上下文，
     * 于是支线的结论真正"汇入主干"。
     */
    suspend fun mergeBranchInsight(job: BranchMergeJob, insight: String): Result<Unit> =
        withContext(Dispatchers.IO) {
            val clean = insight.trim()
            if (clean.isBlank()) {
                return@withContext Result.failure(IllegalStateException("结论内容不能为空"))
            }
            val branch = dao.getNodeById(job.branchNodeId)
                ?: return@withContext Result.failure(IllegalStateException("找不到该分支卡片"))
            val parentId = branch.parentId
            if (parentId.isNullOrBlank()) {
                return@withContext Result.failure(
                    IllegalStateException("当前节点为主干根节点，无母节点可反哺")
                )
            }
            val content = buildString {
                append("【支线洞察卡片】\n")
                append("来自探索分支：「").append(job.branchTitle).append("」\n")
                append("核心结论：\n").append(clean)
            }
            dao.insertMessage(
                ChatMessage(
                    nodeId = parentId,
                    role = "assistant",
                    content = content
                )
            )
            dao.updateNode(branch.copy(summary = clean))
            Result.success(Unit)
        }

    // ------------------------------------------------------------ 笔记高亮

    /** 当前节点下所有消息的高亮（UI 按 messageId 分组使用）。 */
    fun getHighlightsForNode(nodeId: String): Flow<List<Highlight>> =
        highlightDao.observeForNode(nodeId)

    /**
     * 加/取消一条高亮。
     *
     * 用"同消息同范围"判定是否已存在，而不是靠 UI 传 id：
     * 同一段文字可能被用户在调整选区后重复标记，按范围判重能自然合并；
     * 已存在则删除，实现工具条上「高亮 / 取消高亮」的单按钮切换。
     */
    /**
     * 加/取消高亮，支持**一次提交多个区间**。
     *
     * 为什么需要多区间：跨块选区（例如从标题一直选到第二段）在源 Markdown 上
     * 不是一段连续区间 —— 中间还夹着井号、列表符号等标记。若硬凑成一个
     * 大区间存下来，下次渲染时那些标记也会被一起点亮。所以跨块选择就拆成
     * 每块一条高亮。
     *
     * 判重按"同消息同范围"，全部区间都已存在则视为取消（整条删除），
     * 否则补齐缺失的那些。这样工具条上的「高亮 / 取消高亮」始终是单按钮切换。
     */
    /**
     * 切换高亮状态：
     * 如果当前选区与任何已有高亮有重叠，点击即为"取消/清除高亮"（清理重叠高亮）；
     * 否则为新增高亮。彻底解决用户选区没有精确到单个字符就无法取消高亮的顽疾。
     */
    fun toggleHighlights(
        messageId: String,
        nodeId: String,
        ranges: List<Pair<Int, Int>>
    ) {
        val valid = ranges.filter { it.first < it.second }
        if (valid.isEmpty()) return
        viewModelScope.launch(Dispatchers.IO) {
            val existing = highlightDao.getForMessage(messageId)
            val hasOverlap = valid.any { range ->
                existing.any { h -> !(h.endOffset <= range.first || h.startOffset >= range.second) }
            }
            if (hasOverlap) {
                // 存在重叠，视为取消高亮：清除所有与选区重叠的高亮条目
                valid.forEach { range ->
                    highlightDao.deleteOverlapping(messageId, range.first, range.second)
                }
            } else {
                valid.forEach { range ->
                    highlightDao.insert(
                        Highlight(
                            messageId = messageId,
                            nodeId = nodeId,
                            startOffset = range.first,
                            endOffset = range.second
                        )
                    )
                }
            }
        }
    }

    /** 撤回当前消息最近一次添加的高亮条目 */
    fun undoLatestHighlight(messageId: String) {
        viewModelScope.launch(Dispatchers.IO) {
            highlightDao.deleteLatest(messageId)
        }
    }

    /** 这条消息属于哪个节点（引用卡片跳回原文时需要知道目标会话/分支）。 */
    suspend fun nodeIdOfMessage(messageId: String): String? = withContext(Dispatchers.IO) {
        dao.getNodeIdForMessage(messageId)
    }

    /**
     * 某分支里最后一条消息的 id。
     *
     * 用于"从当前视图分叉"时记录来源消息：用户看到的是最后一条，
     * 引用卡片跳回来自然也应该落在它上面。
     */
    suspend fun latestMessageIdOfNode(nodeId: String): String? = withContext(Dispatchers.IO) {
        dao.getMessagesForNode(nodeId).lastOrNull()?.id
    }

    /**
     * 为「活体手写笔记快照」批量读取各分支节点的核心问答摘要。
     *
     * 当用户在笔记界面把卡片拉大时，卡片内即可展示这段核心正文，方便用荧光笔划重点或贴遮挡胶带。
     */
    suspend fun loadNodeSummaries(nodeIds: List<String>): Map<String, String> =
        withContext(Dispatchers.IO) {
            val result = mutableMapOf<String, String>()
            for (id in nodeIds) {
                val msgs = dao.getMessagesForNode(id)
                if (msgs.isEmpty()) continue
                val lastAssistant = msgs.lastOrNull { it.role == "assistant" && it.content.isNotBlank() }
                val lastUser = msgs.lastOrNull { it.role == "user" && it.content.isNotBlank() }
                val raw = buildString {
                    if (lastUser != null) {
                        append("问：").append(lastUser.content.replace("\n", " ").take(72)).append("\n")
                    }
                    if (lastAssistant != null) {
                        val cleaned = lastAssistant.content
                            .replace(Regex("```[\\s\\S]*?```"), "[代码段]")
                            .replace(Regex("[#*>`~]+"), "")
                            .replace(Regex("\\n{2,}"), "\n")
                            .trim()
                        append(cleaned.take(360))
                    }
                }.trim()
                if (raw.isNotBlank()) {
                    result[id] = raw
                }
            }
            result
        }

    /** 某个节点属于哪个会话（跨会话跳转时需要先把目标会话切成当前会话）。 */
    suspend fun conversationIdOfNode(nodeId: String): String? = withContext(Dispatchers.IO) {
        dao.getNodeById(nodeId)?.conversationId
    }

    /** 该消息上是否已经存在同一范围的高亮（工具条据此显示"取消高亮"）。 */
    suspend fun hasHighlight(messageId: String, start: Int, end: Int): Boolean =
        withContext(Dispatchers.IO) {
            highlightDao.getForMessage(messageId)
                .any { it.startOffset == start && it.endOffset == end }
        }


    /**
     * 发送一条用户消息。
     *
     * @param images 随消息附带的图片（**已压缩过的 data URI**，见 ImagePicker）。
     *   直接存库而不存文件路径：相册给的 content:// 授权是临时的，
     *   进程重启后失效，只有字节本身才能做到"重启后历史图片还在"。
     */
    fun sendMessage(nodeId: String, userText: String, images: List<String> = emptyList()) {
        // 只有图片没有文字时也要允许发送（用户可能只想问"这张图是什么"），
        // 所以判空条件改为"文字与图片都为空"才拦截。
        if (userText.isBlank() && images.isEmpty()) return
        viewModelScope.launch(Dispatchers.IO) {
            dao.insertMessage(
                ChatMessage(
                    nodeId = nodeId,
                    role = "user",
                    content = userText.trim(),
                    imagesJson = encodeImages(images)
                )
            )
            // 让最近活跃的会话排到列表最前
            _activeConversationId.value?.let { folderDao.touchConversation(it, System.currentTimeMillis()) }
            runCompletion(nodeId)
        }
    }

    fun regenerateLast(nodeId: String) {
        if (_streamingNodes.value.contains(nodeId)) return
        viewModelScope.launch(Dispatchers.IO) {
            val messages = dao.getMessagesForNode(nodeId)
            val lastUserIndex = messages.indexOfLast { it.role == "user" }
            if (lastUserIndex < 0) return@launch
            messages.drop(lastUserIndex + 1)
                .filter { it.role == "assistant" }
                .forEach { dao.deleteMessage(it.id) }
            runCompletion(nodeId)
        }
    }

    /** 删除单条消息（单个对话内容）。 */
    fun deleteSingleMessage(messageId: String) {
        viewModelScope.launch(Dispatchers.IO) {
            dao.deleteMessage(messageId)
        }
    }

    fun stopStreaming(nodeId: String) {
        activeJobs.remove(nodeId)?.cancel()
        _streamingNodes.value = _streamingNodes.value - nodeId
        _searchingQuery.value = null
    }

    fun deleteNode(nodeId: String) {
        viewModelScope.launch(Dispatchers.IO) {
            val node = dao.getNodeById(nodeId) ?: return@launch
            if (node.parentId == null) return@launch
            stopStreaming(nodeId)
            dao.deleteNodeById(nodeId)
        }
    }

    fun renameNode(nodeId: String, newTitle: String) {
        if (newTitle.isBlank()) return
        viewModelScope.launch(Dispatchers.IO) {
            val node = dao.getNodeById(nodeId) ?: return@launch
            dao.updateNode(node.copy(title = newTitle.trim()))
        }
    }

    fun updateSummary(nodeId: String, summary: String) {
        viewModelScope.launch(Dispatchers.IO) {
            val node = dao.getNodeById(nodeId) ?: return@launch
            dao.updateNode(node.copy(summary = summary))
        }
    }

    // ========================================================================
    // 流式补全
    // ========================================================================

    private suspend fun runCompletion(nodeId: String) {
        val provider = activeProvider
        val deepseekKey = savedProviders
            .firstOrNull {
                it.id.contains("deepseek", ignoreCase = true) ||
                    it.baseUrl.contains("api.deepseek.com", ignoreCase = true)
            }
            ?.apiKey
            ?.takeIf { it.isNotBlank() }
            ?: provider.apiKey.takeIf {
                provider.id.contains("deepseek", ignoreCase = true) ||
                    provider.baseUrl.contains("api.deepseek.com", ignoreCase = true)
            }.orEmpty()
        val searchConfig = settings.searchConfig().copy(deepseekApiKey = deepseekKey)

        if (provider.apiKey.isBlank()) {
            dao.insertMessage(
                ChatMessage(
                    nodeId = nodeId,
                    role = "assistant",
                    content = "尚未配置 API 密钥。\n\n请点击右上角 **设置** 填写 API 地址与密钥后再对话。"
                )
            )
            return
        }

        val currentNode = dao.getNodeById(nodeId)
        val ancestors = dao.getAncestorChain(nodeId)
        val promptList = mutableListOf<PromptMessage>()

        // 彻底解决"选句后针对提问 AI 回复没有上下文"的根因：
        // 从当前节点本身及祖先链路上提取用户选中的原文段落（originQuote），
        // 即使是阅读器/浏览器新建的 Root 树也能精准捕获
        val activeOriginQuote = (listOfNotNull(currentNode) + ancestors.reversed())
            .mapNotNull { it.originQuote?.trim() }
            .firstOrNull { it.isNotBlank() }

        if (!activeOriginQuote.isNullOrBlank()) {
            promptList.add(
                PromptMessage(
                    role = "system",
                    content = "【当前讨论分支引用的原文段落】：\n「$activeOriginQuote」\n用户在此分支的提问均针对此段内容展开。"
                )
            )
        }

        for (ancestor in ancestors) {
            if (!ancestor.originQuote.isNullOrBlank()) {
                promptList.add(
                    PromptMessage(
                        role = "system",
                        content = "当前讨论分支聚焦于上级引用的这段内容：「${ancestor.originQuote}」。"
                    )
                )
            }
            if (!ancestor.summary.isNullOrBlank()) {
                promptList.add(
                    PromptMessage(role = "system", content = "【历史脉络摘要】${ancestor.summary}")
                )
            }
            dao.getMessagesForNode(ancestor.id).forEach { message ->
                if (message.content.isNotBlank()) {
                    promptList.add(
                        PromptMessage(
                            role = message.role,
                            content = message.content,
                            images = decodeImages(message.imagesJson)
                        )
                    )
                }
            }
        }

        // ---- 只保留最后一条用户消息的图片 ----
        //
        // 为什么必须这样：图片存的是 base64 data URI，体积比原文膨胀约 33%。
        // 若每轮都把历史图片重发一遍，几轮之后 token 消耗会爆炸
        // （而且模型对"更早的图"通常也不再需要）。
        // 只带最新一轮的图，既让模型看到本次问题附的图，又不让上下文无限膨胀。
        val lastUserIndex = promptList.indexOfLast { it.role == "user" }
        if (lastUserIndex >= 0) {
            for (i in promptList.indices) {
                if (i != lastUserIndex && promptList[i].images.isNotEmpty()) {
                    promptList[i] = promptList[i].copy(images = emptyList())
                }
            }
        }

        // ---- 提示词长度预算（这是本地模型"巨慢/卡在生成中"的主因）----
        // 上面把**整条祖先链上每个节点的全部消息**都拼了进来，且没有任何上限：
        // 对话树是本应用的核心用法，用着用着 prompt 就会涨到几千 token。
        // 历史上有过"本地引擎 prefill 纯 CPU 串行、首字迟迟不来"的问题；
        // 本地大模型方案现已整体移除，这里只按云端口径做一次字符预算裁剪。
        val promptListTrimmed = trimPromptListToBudget(
            promptList,
            CLOUD_CONTEXT_CHAR_BUDGET
        )

        val basePrompt = settings.systemPrompt
            .takeIf { it.isNotBlank() }
            ?: AppSettings.DEFAULT_SYSTEM_PROMPT

        // ---- 本地教材检索（RAG）----
        //
        // 用**最后一条用户消息**作为查询：当前这一轮要回答的就是它。
        // 用整段对话会稀释关键词，反而降低召回（本项目实测 2 字组检索
        // 对"问题短、术语集中"的查询效果最好）。
        val knowledgeSection = if (settings.knowledgeEnabled) {
            val lastUserText = promptListTrimmed.lastOrNull { it.role == "user" }?.content.orEmpty()
            if (lastUserText.isBlank()) {
                KnowledgeRetriever.EMPTY
            } else {
                // 检索失败绝不能让整轮对话失败：教材是增强手段，
                // 它出问题时应当退化成普通问答，而不是报错。
                runCatching {
                    knowledgeRetriever.retrieveWithConfig(
                        query = lastUserText,
                        topK = KnowledgeRetriever.DEFAULT_TOP_K,
                        cloudConfig = settings.cloudRagConfig(),
                        embeddingClient = cloudEmbeddingClient
                    )
                }.getOrElse { KnowledgeRetriever.EMPTY }
            }
        } else {
            KnowledgeRetriever.EMPTY
        }
        _lastKnowledgeCitations.value = KnowledgeRetriever.citationsOf(knowledgeSection)

        val effectivePrompt = buildString {
            append(basePrompt)
            if (!activeOriginQuote.isNullOrBlank()) {
                append("\n\n【用户重点关注与引用的原文/上下文段落】：\n「$activeOriginQuote」\n用户当前的所有提问都是针对上述引用的原文展开的，请务必结合该段原文的具体语境、词句含义与逻辑进行精准解答。")
            }
            // 概念链接提示：约定模型把值得下钻的核心概念用 [[ ]] 包起来。
            // 前端据此渲染"实线/虚线"概念链接（命中本地词库走词典，未命中走轻量追问）。
            // 放在这里而不是 AppSettings.DEFAULT_SYSTEM_PROMPT：这样用户**自定义**
            // 系统提示词时同样带上这条约定，不必再手写一遍。
            append("\n\n输出时，请用双方括号把值得下钻的核心概念包起来（如 [[递归]]），")
            append("便于读者点击查看释义或词源；只包裹真正的术语/概念名词，")
            append("不要包裹普通词或整句，也不要嵌套标记。")
            if (searchConfig.enabled) {
                append("\n\n你具备联网检索能力。当问题涉及实时信息、当前事件、")
                append("或你不确定的事实时，主动调用 web_search 工具，不要凭记忆猜测。")
                append("引用检索到的资料时用 [编号] 标注来源。")
            }
            // ⚠️ RAG 知识注入**不在这里**：knowledgeSection 每轮检索结果都不同，
            // 拼进 system prompt 会让其后整条祖先链的前缀缓存全部穿透失效。
            // 它改在消息序列末尾注入，见下方 finalPromptList 的构造。
        }

        // ---- 前缀缓存优化：RAG 知识注入移到消息序列末尾 ----
        //
        // 为什么不能再留在 system prompt 里：knowledgeSection 是每轮实时检索的结果，
        // 内容逐轮变化。而 system prompt 位于消息序列最前端，它一变，
        // 其后整条祖先链的前缀缓存全部穿透失效（DeepSeek/Claude 的缓存均按前缀匹配）。
        // 移到末尾后，前端（system + 祖先链）保持字节级稳定，缓存得以命中。
        //
        // 检索查询用的是上面 promptListTrimmed 里最后一条 user 消息的**原始内容**
        // （见 knowledgeSection 的计算），所以在这里追加知识不会污染检索查询本身。
        val knowledgeText = KnowledgeRetriever.buildSystemPromptSection(knowledgeSection)
        val finalPromptList = if (knowledgeText.isNotBlank()) {
            val lastUserIdx = promptListTrimmed.indexOfLast { it.role == "user" }
            if (lastUserIdx >= 0) {
                val original = promptListTrimmed[lastUserIdx]
                promptListTrimmed.toMutableList().also { list ->
                    list[lastUserIdx] = original.copy(
                        content = original.content + "\n\n" + knowledgeText
                    )
                }
            } else {
                // 没有 user 消息时（异常路径），退化为追加一条 system 消息，
                // 保证知识内容不丢失，也不会让整轮对话失败。
                promptListTrimmed + PromptMessage(role = "system", content = knowledgeText)
            }
        } else {
            promptListTrimmed
        }

        val knowledgeSourcesJson = if (knowledgeSection.evidences.isNotEmpty()) {
            gson.toJson(knowledgeSection.evidences)
        } else {
            null
        }

        val assistantMsg = ChatMessage(
            nodeId = nodeId,
            role = "assistant",
            content = "",
            isStreaming = true,
            knowledgeSourcesJson = knowledgeSourcesJson
        )
        dao.insertMessage(assistantMsg)

        _streamingNodes.value = _streamingNodes.value + nodeId

        val builder = StringBuilder()
        // 思考过程单独累积：既要实时显示，也要在结束时落库。
        val reasoningBuilder = StringBuilder()
        val sources = mutableListOf<SearchResult>()
        // 界面刷新节流（约 60fps 上限）：delta 攒着，每 16ms 推一次内存态。
        // 落库是另一个更慢的节流（见 DB_FLUSH_MS），两者分开。
        var lastUiPush = 0L
        // 落库节流：流式期间每 500ms 写一次快照（崩溃/杀进程不丢全文），
        // 平时界面只读内存态，不走 Room。
        var lastDbFlush = 0L

        val job = viewModelScope.launch(Dispatchers.IO) {
            try {
                aiClient.runChat(
                    provider = provider,
                    messages = finalPromptList,
                    systemPrompt = effectivePrompt,
                    searchConfig = searchConfig
                ).collect { event ->
                    when (event) {
                        is ChatEvent.Text -> {
                            builder.append(event.delta)
                            val now = System.currentTimeMillis()
                            // 快路径：内存态即时刷新（界面直接读 streamingText，不等 Room）。
                            // 16ms 节流 ≈ 60fps：比这更快人眼也分辨不出，还省重组。
                            if (now - lastUiPush > 16) {
                                lastUiPush = now
                                _streamingText.value =
                                    _streamingText.value + (nodeId to builder.toString())
                            }
                            // 慢路径：落库快照（崩溃不丢全文即可，不用跟手速）。
                            if (now - lastDbFlush > 500) {
                                lastDbFlush = now
                                dao.updateMessage(
                                    assistantMsg.copy(
                                        content = builder.toString(),
                                        isStreaming = true
                                    )
                                )
                            }
                        }

                        is ChatEvent.Reasoning -> {
                            // 思考内容：累积 + 立刻推给界面。
                            reasoningBuilder.append(event.delta)
                            val now = System.currentTimeMillis()
                            if (now - lastUiPush > 16) {
                                lastUiPush = now
                                _streamingText.value =
                                    _streamingText.value + (nodeId to builder.toString())
                                _streamingReasoning.value =
                                    _streamingReasoning.value + (nodeId to reasoningBuilder.toString())
                            }
                        }

                        is ChatEvent.SearchStarted -> {
                            _searchingQuery.value = event.query
                            dao.updateMessage(
                                assistantMsg.copy(
                                    content = builder.toString().ifBlank { "正在联网检索…" },
                                    isStreaming = true
                                )
                            )
                        }

                        is ChatEvent.SearchFinished -> {
                            _searchingQuery.value = null
                            if (event.error == null) {
                                event.sources.forEach { source ->
                                    if (sources.none { it.url == source.url }) sources.add(source)
                                }
                            } else {
                                builder.append("\n\n> ⚠️ 联网检索提示：${event.error}\n\n")
                            }
                            dao.updateMessage(
                                assistantMsg.copy(
                                    content = builder.toString(),
                                    isStreaming = true,
                                    searchSourcesJson = encodeSources(sources)
                                )
                            )
                        }

                        is ChatEvent.Failed -> {
                            // 失败也要把内存态清掉：否则界面会同时从"实时流"和
                            // "落库消息"两处拿到文本，失败提示后面拖一条影子。
                            _streamingText.value = _streamingText.value - nodeId
                            val text = if (builder.isEmpty()) {
                                "**请求失败**\n\n${event.message}"
                            } else {
                                "${builder}\n\n---\n\n**传输中断**：${event.message}"
                            }
                            dao.updateMessage(
                                assistantMsg.copy(content = text, isStreaming = false)
                            )
                        }
                    }
                }

                val reasoning = reasoningBuilder.toString().takeIf { it.isNotBlank() }
                // 实时状态用完即清：内容已经落到消息里了，
                // 留着会让界面同时从"实时流"和"消息"两处拿到同一段思考而重复显示。
                _streamingReasoning.value = _streamingReasoning.value - nodeId
                // 正文内存态同样清掉：此后界面只读落库的最终版本。
                _streamingText.value = _streamingText.value - nodeId

                dao.updateMessage(
                    assistantMsg.copy(
                        content = builder.toString().ifBlank { "（无输出）" },
                        isStreaming = false,
                        searchSourcesJson = encodeSources(sources),
                        reasoningContent = reasoning
                    )
                )
            } catch (e: kotlinx.coroutines.CancellationException) {
                // 用户点了"停止生成"。这里的收尾写入**必须放在 NonCancellable 里**：
                // 协程已被取消，直接 suspend 调用会在第一个挂起点抛 CancellationException，
                // 于是 `isStreaming = false` 永远写不进库 —— 消息会永久留在
                // "生成中"状态，用户必须重启 App 才消失。这正是之前那个现象的根因之一。
                withContext(NonCancellable) {
                    _streamingText.value = _streamingText.value - nodeId
                    dao.updateMessage(
                        assistantMsg.copy(
                            content = builder.toString().ifBlank { "（已停止生成）" },
                            isStreaming = false,
                            searchSourcesJson = encodeSources(sources),
                            // 被中途停止时也保留已经收到的思考内容：
                            // 那部分思考是用户已经"付费"等来的，丢掉可惜
                            reasoningContent = reasoningBuilder.toString().takeIf { it.isNotBlank() }
                        )
                    )
                }
                throw e
            } catch (e: Exception) {
                _streamingText.value = _streamingText.value - nodeId
                _streamingReasoning.value = _streamingReasoning.value - nodeId
                dao.updateMessage(
                    assistantMsg.copy(
                        content = builder.toString() + "\n\n---\n\n**异常**：${e.localizedMessage}",
                        isStreaming = false,
                        searchSourcesJson = encodeSources(sources),
                        reasoningContent = reasoningBuilder.toString().takeIf { it.isNotBlank() }
                    )
                )
            } finally {
                _streamingNodes.value = _streamingNodes.value - nodeId
                _searchingQuery.value = null
                // 兜底清理：若在上面的正常路径之后又抛了异常，
                // 实时思考状态不能残留，否则界面会显示一条不存在的"正在思考"
                _streamingReasoning.value = _streamingReasoning.value - nodeId
                activeJobs.remove(nodeId)
            }
        }
        activeJobs[nodeId] = job
    }

    private fun encodeSources(sources: List<SearchResult>): String? =
        if (sources.isEmpty()) null else gson.toJson(sources)

    /**
     * 按字符预算裁剪提示词：**从最新的往回收**，超预算的老消息丢掉。
     * 若预算极紧，仍保证最后一条用户消息在（那是本次提问本身）。
     */
    private fun trimPromptListToBudget(
        list: List<PromptMessage>,
        budgetChars: Int
    ): List<PromptMessage> {
        if (list.isEmpty()) return list
        val kept = ArrayDeque<PromptMessage>()
        var used = 0
        for (i in list.indices.reversed()) {
            val m = list[i]
            // 每条按内容长度 + 少量模板开销估算；够精确就行，不必真分词
            val cost = m.content.length + 16
            if (kept.isNotEmpty() && used + cost > budgetChars) break
            kept.addFirst(m)
            used += cost
        }
        val lastUser = list.lastOrNull { it.role == "user" }
        if (lastUser != null && kept.none { it.role == "user" && it.content === lastUser.content }) {
            kept.addLast(lastUser)
        }
        return kept.toList()
    }

    companion object {

        /**
         * 本地引擎提示词字符预算的**默认值**（可在设置里改，见 [resolveLocalContextBudget]）。
         *
         * CPU prefill 耗时与长度成正比：预算越大，模型能记住的对话轮数越多，但首字越慢。
         * 1600 字符 ≈ 1000~1600 token ≈ 最近 1~2 轮；要给到 8K 上下文的量级就调到 6000 以上。
         */
        private const val LOCAL_CONTEXT_CHAR_BUDGET = 1_600

        /** 预置档位：保守 / 均衡 / 长记忆（字符数）。 */
        val LOCAL_CONTEXT_BUDGET_PRESETS = listOf(1_600, 3_200, 6_000)

        /** 读取用户在设置里选的本地上下文预算（不在预置里就用默认）。 */
        private fun resolveLocalContextBudget(context: android.content.Context?): Int {
            val ctx = context ?: return LOCAL_CONTEXT_CHAR_BUDGET
            return runCatching {
                ctx.getSharedPreferences("treechat_settings", android.content.Context.MODE_PRIVATE)
                    .getInt(KEY_LOCAL_CONTEXT_BUDGET, LOCAL_CONTEXT_CHAR_BUDGET)
                    .coerceIn(800, 24_000)
            }.getOrDefault(LOCAL_CONTEXT_CHAR_BUDGET)
        }

        const val KEY_LOCAL_CONTEXT_BUDGET = "local_context_char_budget"

        /** 写设置（设置面板用）。 */
        fun setLocalContextBudget(context: android.content.Context?, budgetChars: Int) {
            val ctx = context ?: return
            runCatching {
                ctx.getSharedPreferences("treechat_settings", android.content.Context.MODE_PRIVATE)
                    .edit().putInt(KEY_LOCAL_CONTEXT_BUDGET, budgetChars.coerceIn(800, 24_000)).apply()
            }
        }

        /** 云端引擎：prefill 在服务端，预算放宽即可。 */
        private const val CLOUD_CONTEXT_CHAR_BUDGET = 24_000

