    /**
     * 词条释义的云端翻译（词典页「云端翻译」按钮）。
     *
     * 只翻译**已经存在的词库释义原文**，不生成新内容、不联网检索 —— 提示词里
     * 把词条与释义原文一并给出，让多义词有上下文可依，但模型没有别的发挥空间。
     * 走 [streamOneShotText] 这条与对话完全相同的通路，因此服务商换成什么都能用。
     *
     * @param headword 词条本身（仅作上下文，不参与检索）。
     * @param sourceGloss 词库里的释义原文；空白时**不发请求**，直接给一条空流。
     * @param targetLanguage 目标语言的中文名（默认"中文"），由界面给出。
     */
    fun streamEntryTranslation(
        headword: String,
        sourceGloss: String,
        targetLanguage: String = "中文"
    ): Flow<String> {
        val cleanHeadword = headword.trim()
        val cleanGloss = sourceGloss.trim()
        if (cleanGloss.isEmpty()) return flowOf("")
        return streamOneShotText(
            systemPrompt = "你是词典释义译者。只输出译文本身，不要解释、不要 markdown、不要引号、不要编号。",
            userPrompt = "词条：$cleanHeadword\n" +
                "词库释义原文：\n$cleanGloss\n\n" +
                "把上面这条词库释义翻译成$targetLanguage。只输出译文。"
        )
    }

    /**
     * 句法切分（流式，一次性）。要求模型返回**严格 JSON 数组**，schema 见
     * [SYNTAX_JSON_CONTRACT]。
     */
    fun streamSyntaxAnalysis(sourceText: String): Flow<String> =
        streamOneShotText(
            systemPrompt = "你是句法结构分析助手。严格只输出一个 JSON 数组，" +
                "不要输出任何解释文字、不要用 Markdown 代码块包裹。",
            userPrompt = "$SYNTAX_JSON_CONTRACT\n\n待分析文本：\n$sourceText"
        )

    /**
     * 一次性文本推理：不落库、不写入对话树、不联网检索，与对话走同一条通路。
     *
     * 失败一律以异常抛出（网络错误、模型报错、未配置密钥/未挂载本地模型），
     * 由调用方决定怎么如实呈现 —— 这里绝不返回"看起来像成功"的空字符串。
     */
    private fun streamOneShotText(systemPrompt: String, userPrompt: String): Flow<String> = flow {
        oneShotUnavailableReason()?.let { throw IllegalStateException(it) }
        val provider = activeProvider
        aiClient.runChat(
            provider = provider,
            messages = listOf(PromptMessage(role = "user", content = userPrompt)),
            systemPrompt = systemPrompt,
            searchConfig = settings.searchConfig().copy(enabled = false)
        ).collect { event ->
            when (event) {
                is ChatEvent.Text -> emit(event.delta)
                is ChatEvent.Failed -> throw IllegalStateException(event.message)
                else -> Unit
            }
        }
    }

